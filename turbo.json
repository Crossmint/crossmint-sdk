{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "env": ["NODE_ENV"],
            "outputLogs": "new-only",
            "dependsOn": ["^build"]
        },
        "test:vitest": {
            "env": ["PREVIEW_CK_KEY"],
            "outputLogs": "new-only"
        },
        "test:integration": {
            "env": ["TESTS_PREVIEW_CROSSMINT_SERVER_API_KEY", "CROSSMINT_BASE_URL"],
            "outputLogs": "new-only",
            "cache": false
        }
    }
}
