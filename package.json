        "ts-jest": "29.1.1",
        "tsup": "8.1.0",
        "turbo": "2.9.14",
        "typescript": "5.5.3",
        "vitest": "3.2.6",
        "vitest-mock-extended": "2.0.2"
    },
    "packageManager": "pnpm@9.3.0",
    "engines": {
        "node": ">=20.19.4",
        "npm": "please-use-pnpm",
        "pnpm": ">=9",
        "yarn": "please-use-pnpm"
    },
