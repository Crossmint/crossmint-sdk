engine-strict=true
save-exact=true

# Required for React Native monorepo: prevents duplicate native modules
shamefully-hoist=true
auto-install-peers=false

# Dependencies resolve from Chainguard Libraries. The token is not here: it lives in the
# user-level npmrc that scripts/setup-pnpm-auth.sh writes, so this file never holds a credential.
registry=https://libraries.cgr.dev/javascript/

# Our own SDKs: Chainguard's 7-day cooldown would hide versions we just published. `pnpm publish`
# reads this line too, so @crossmint/* publishes to npmjs.org.
@crossmint:registry=https://registry.npmjs.org/

# Record every entry's tarball URL, so a version locked while Chainguard still mirrored it from
# /javascript-upstream/ keeps that URL once Chainguard rebuilds it under /javascript/.
lockfile-include-tarball-url=true

# TODO(WAL-13249): 5 lockfile entries still pin registry.npmjs.org tarballs, because Chainguard
# withheld those versions on 2026-10-27 (bitcoinjs-lib@6.1.10 in cooldown; @dynamic-labs/wallet-book@4.100.5
# and @noxcturnal/noxcturnal-*@0.1.2 pending a malware scan). Until they move, the lockfile is not
# fully covered by Chainguard's rebuilds. The follow-up should first evaluate whether these packages
# are needed at all.

# Chainguard answers 409 or a bad hash now and then under parallel CI installs, and pnpm's default
# 2 retries give up inside one blip. A retry re-checks the hash recorded in the lockfile.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
